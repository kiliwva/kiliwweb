{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiliwweb",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // every request goes through the Worker first: auth redirects,
    // session-gated cloud app, /api/* routes
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "KILIW_FILES",
      // create a bucket with exactly this name in the Cloudflare dashboard (R2)
      "bucket_name": "kiliw-files"
    }
  ],
  "ai": {
    // Workers AI: content-based 18+ detection for shared images
    "binding": "AI"
  },
  "vars": {
    // the site owner gets a permanent 1 TB Pro plan
    "OWNER_EMAIL": "denislybin3@gmail.com",
    // Minecraft nicks whose linked Telegram is a K-MCID panel admin
    // (comma-separated; the panel at mcid.<domain> checks this)
    "MCID_ADMIN_NICKS": "kiliwva"
  },
  // never wipe dashboard-added variables (OAuth client ids etc.) on deploy
  "keep_vars": true,
  "placement": {
    // run the Worker near the origins it calls (Heleket, Resend) instead of
    // near the visitor — payment providers often geo-block user-region IPs
    "mode": "smart"
  },
  "triggers": {
    // daily 03:00 UTC: purge accounts whose 7-day deletion grace expired
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
